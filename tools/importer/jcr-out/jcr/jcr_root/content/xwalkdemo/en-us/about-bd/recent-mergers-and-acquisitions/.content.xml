  <jcr:content cq:template="/libs/core/franklin/templates/page" sling:resourceType="core/franklin/components/page/v1/page" jcr:primaryType="cq:PageContent" jcr:title="Recent Mergers and Acquisitions" modelFields="[jcr:title,jcr:description,keywords]">
